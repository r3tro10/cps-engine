        -state_: JointState
        +setCommand(target_effort: double) void
        +getState() JointState
        +update(dt: double) void
    }

    class ISensor {
        <<interface>>
        +~ISensor()
        +read_telemetry() double
        +get_name() string
        #ISensor()
    }

